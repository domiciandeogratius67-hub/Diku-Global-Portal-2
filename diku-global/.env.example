# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=production
PORT=3000
DOMAIN=yourdomain.com

# npm run secret
JWT_SECRET=
ADMIN_EMAIL=admin@yourdomain.com
# npm run hash -- "a-long-strong-password"
ADMIN_PASSWORD_HASH=

# 1 = behind Caddy/Nginx. 2 = behind Cloudflare AND Caddy/Nginx. 0 = direct.
TRUST_PROXY=1

# Where the database and uploaded pictures live. MUST be on a persistent disk/volume.
# (Docker sets these for you.)
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# Bot protection (free): https://dash.cloudflare.com -> Turnstile. Leave blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Instant phone alerts for new orders and NEW website errors (Telegram bot). Optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
